{
  "name": "wiggleplay-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@dr.pogodin/react-native-static-server": "^0.28.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "prebuild": "npm run sync-web && LANG=en_US.UTF-8 expo prebuild --clean",
    "ios": "npm run sync-web && LANG=en_US.UTF-8 expo run:ios",
    "android": "npm run sync-web && expo run:android",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "node --experimental-strip-types --test src/paths.test.ts src/manifest.test.ts src/host-bridge.test.ts"
  },
  "private": true
}
